# Copy to .env and adjust as needed. All values have safe defaults (see tests/support/env.ts).

# Base URL of the Streamhub Catalogue API under test (B1/B2).
# Playwright starts the API automatically on this URL's port.
API_BASE_URL=http://localhost:3000

# Base URL of the EMI Calculator web app (B3).
UI_BASE_URL=https://emicalculator.net

# Anthropic Key for self-healing testing
ANTHROPIC_API_KEY=


