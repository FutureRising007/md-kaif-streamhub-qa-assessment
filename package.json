{
  "name": "streamhub-qa-assessment",
  "version": "1.0.0",
  "description": "Streamhub QA Automation Assessment (Section B): Streaming Catalogue API + Playwright/Cucumber API & UI automation + SQL",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "api:start": "tsx api/src/server.ts",
    "api:dev": "tsx watch api/src/server.ts",
    "bddgen": "bddgen",
    "test": "bddgen && playwright test --project=api --project=ui",
    "test:api": "bddgen && playwright test --project=api",
    "test:ui": "bddgen && playwright test --project=ui",
    "test:headed": "bddgen && playwright test --project=ui --headed",
    "test:self-healing": "bddgen && playwright test --project=self-healing --reporter=list",
    "heal": "tsx tools/self-heal/heal.ts",
    "sql": "cross-env NODE_NO_WARNINGS=1 tsx sql/run.ts",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
